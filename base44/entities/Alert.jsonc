{
  "name": "Alert",
  "type": "object",
  "properties": {
    "crisis_id": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "leve",
        "moderada",
        "intensa"
      ],
      "default": "moderada"
    },
    "message": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "date_time": {
      "type": "string",
      "format": "date-time"
    },
    "alert_type": {
      "type": "string",
      "enum": [
        "crise_detectada",
        "manual",
        "teste"
      ],
      "default": "crise_detectada"
    }
  },
  "required": [
    "date_time"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}