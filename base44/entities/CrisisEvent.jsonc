{
  "name": "CrisisEvent",
  "type": "object",
  "properties": {
    "date_time": {
      "type": "string",
      "format": "date-time"
    },
    "duration_seconds": {
      "type": "number"
    },
    "heart_rate_avg": {
      "type": "number"
    },
    "heart_rate_peak": {
      "type": "number"
    },
    "movement_intensity": {
      "type": "string",
      "enum": [
        "baixa",
        "m\u00e9dia",
        "alta"
      ]
    },
    "intensity": {
      "type": "string",
      "enum": [
        "leve",
        "moderada",
        "intensa"
      ]
    },
    "location": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "date_time"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}